{
  "manifest_version": "0.2",
  "name": "mcp-links-service",
  "version": "0.1.0",
  "description": "Centralized Webapp and Container Links Service",
  "author": { "name": "sandraschi" },
  "server": {
    "type": "python",
    "entry_point": "src/mcp_links_service/server.py",
    "mcp_config": {
      "command": "uv",
      "args": ["run","--directory","${PWD}","python","-m","mcp_links_service"],
      "env": {
        "PYTHONPATH": "${PWD}/src",
        "PYTHONUNBUFFERED": "1"
      }
    }
  },
  "tools": [
    { "name": "mcp-links-service", "description": "Centralized Webapp and Container Links Service" }
  ]
}
